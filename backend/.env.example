PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/medassist
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
# Set only when the API is reachable exclusively through your trusted proxy.
TRUST_PROXY=
STRUCTURED_LOGS=false
JWT_ACCESS_TOKEN=replace-with-a-unique-random-32-character-secret
JWT_REFRESH_TOKEN=replace-with-a-different-random-32-character-secret
JWT_VERIFICATION_TOKEN=replace-with-another-random-32-character-secret
JWT_RESET_TOKEN=replace-with-a-fourth-random-32-character-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional generation provider: gemini, groq, together, or local (OpenAI-compatible).
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TOGETHER_API_KEY=
TOGETHER_MODEL=
LOCAL_AI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
# Optional: 64 random hexadecimal characters. Keep stable and backed up to let users store encrypted personal keys.
USER_API_KEY_ENCRYPTION_KEY=
# Optional second Gemini call checks medical drafts against supplied abstracts.
GEMINI_VERIFY_ANSWERS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example when enabled: http://127.0.0.1:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=
NCBI_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=MedAssist AI
DATASET_REPORT_DIR=
